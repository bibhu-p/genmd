---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import DocsNav from '../components/docs/DocsNav.astro';
import { DOC_SECTION_LABELS } from '../data/docs-sections';
import { DOCS_INDEX_ID, docHref, groupBySection, neighbours } from '../lib/docs-nav';
import type { DocEntry } from '../lib/docs';

interface Props {
  entry: DocEntry;
  headings: MarkdownHeading[];
  /** All docs pages in reading order. */
  docs: DocEntry[];
}

const { entry, headings, docs } = Astro.props;
const { title, description, section, sources, lastVerified } = entry.data;

const isIndex = entry.id === DOCS_INDEX_ID;
const groups = groupBySection(docs);
const { previous, next } = neighbours(docs, entry.id);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const lastVerifiedLabel = lastVerified?.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={title} description={description}>
  <div
    class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-10 lg:py-12 xl:grid-cols-[14rem_minmax(0,1fr)_12rem]"
  >
    <!-- Mobile: collapsible menu. Desktop: sticky sidebar. Only one is displayed at a time. -->
    <details class="group mb-8 rounded-xl border border-line lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-xl px-4 py-3 text-sm font-semibold [&::-webkit-details-marker]:hidden"
      >
        <span><span class="text-ink-muted">Docs:</span> {title}</span>
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-5 text-ink-subtle transition-transform group-open:rotate-180">
          <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
        </svg>
      </summary>
      <nav aria-label="Docs" class="border-t border-line p-2 pb-3">
        <DocsNav groups={groups} currentId={entry.id} />
      </nav>
    </details>

    <nav
      aria-label="Docs"
      class="hidden lg:sticky lg:top-24 lg:block lg:max-h-[calc(100vh-7rem)] lg:self-start lg:overflow-y-auto lg:pb-8"
    >
      <DocsNav groups={groups} currentId={entry.id} />
    </nav>

    <article class="min-w-0">
      {
        !isIndex && (
          <nav aria-label="Breadcrumb" class="text-sm text-ink-muted">
            <ol class="flex flex-wrap items-center gap-1.5">
              <li>
                <a href="/docs/" class="hover:text-ink hover:underline">Docs</a>
              </li>
              <li aria-hidden="true">/</li>
              <li>{DOC_SECTION_LABELS[section]}</li>
            </ol>
          </nav>
        )
      }
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-balance sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-ink-muted">{description}</p>

      <div class="docs-prose mt-8">
        <slot />
      </div>

      <slot name="after" />

      {
        (sources.length > 0 || lastVerifiedLabel) && (
          <aside aria-label="Sources" class="mt-12 rounded-xl border border-line bg-subtle p-5 text-sm">
            {sources.length > 0 && (
              <>
                <p class="font-semibold">Official sources</p>
                <ul class="mt-2 space-y-1">
                  {sources.map((source) => (
                    <li>
                      <a href={source.url} rel="noopener" class="text-accent underline underline-offset-2">
                        {source.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {lastVerifiedLabel && (
              <div class:list={['space-y-3', sources.length > 0 && 'mt-4']}>
                <p class="text-ink-muted">
                  Last checked: <time datetime={lastVerified?.toISOString().slice(0, 10)}>{lastVerifiedLabel}</time>
                </p>
                <p class="flex items-start gap-2 rounded-lg border border-warn bg-warn-soft px-3 py-2 font-medium text-warn-ink">
                  <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-4 shrink-0">
                    <path
                      fill-rule="evenodd"
                      d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Claude Code updates often. Verify details in the official docs.
                </p>
              </div>
            )}
          </aside>
        )
      }

      {
        (previous || next) && (
          <nav aria-label="Previous and next pages" class="mt-10 grid gap-3 sm:grid-cols-2">
            {previous ? (
              <a href={docHref(previous.id)} class="group rounded-xl border border-line p-4 transition-colors hover:border-line-strong hover:bg-subtle">
                <span class="text-xs text-ink-subtle">Previous</span>
                <span class="mt-1 block font-semibold group-hover:text-accent">
                  <span aria-hidden="true">← </span>
                  {previous.data.title}
                </span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={docHref(next.id)} class="group rounded-xl border border-line p-4 text-right transition-colors hover:border-line-strong hover:bg-subtle">
                <span class="text-xs text-ink-subtle">Next</span>
                <span class="mt-1 block font-semibold group-hover:text-accent">
                  {next.data.title}
                  <span aria-hidden="true"> →</span>
                </span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    {
      toc.length > 1 && (
        <nav aria-label="On this page" class="hidden xl:sticky xl:top-24 xl:block xl:self-start">
          <p class="text-xs font-semibold tracking-wider text-ink-subtle uppercase">On this page</p>
          <ul class="mt-3 space-y-1 border-l border-line text-sm">
            {toc.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  data-toc-link
                  class:list={[
                    '-ml-px block border-l-2 border-transparent py-1 text-ink-muted transition-colors hover:text-ink aria-[current=location]:border-brand-500 aria-[current=location]:font-medium aria-[current=location]:text-accent',
                    heading.depth === 3 ? 'pl-6' : 'pl-3',
                  ]}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>

  <p class="sr-only" role="status" data-copy-status></p>
</BaseLayout>

<script>
  // Highlights the "On this page" entry for the section currently being read.
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const tocTargets = tocLinks
    .map((link) => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
    .filter((item): item is { link: HTMLAnchorElement; heading: HTMLElement } => item.heading !== null);

  if (tocTargets.length > 0) {
    // Just below the sticky header: a heading counts as current once it scrolls past this line.
    const ACTIVE_LINE = 120;
    let frame = 0;

    const update = () => {
      frame = 0;
      let active = tocTargets[0];
      for (const target of tocTargets) {
        if (target.heading.getBoundingClientRect().top - ACTIVE_LINE <= 0) active = target;
        else break;
      }
      // Short final sections never reach the line, so select the last one at the bottom of the page.
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      if (atBottom) active = tocTargets[tocTargets.length - 1];

      for (const { link } of tocTargets) {
        if (link === active?.link) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }

  // Adds a Copy button to every code block in the docs.
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  document.querySelectorAll<HTMLPreElement>('.docs-prose pre').forEach((pre) => {
    pre.tabIndex = 0; // Scrollable regions must be reachable by keyboard.

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.append(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.textContent = 'Copy';
    button.setAttribute('aria-label', 'Copy code');

    button.addEventListener('click', async () => {
      const text = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
        if (status) status.textContent = 'Code copied to clipboard.';
      } catch {
        window.getSelection()?.selectAllChildren(pre);
        button.textContent = 'Press Ctrl+C';
        if (status) status.textContent = 'Could not copy automatically. The code is selected; press Ctrl+C or Cmd+C.';
      }
      window.setTimeout(() => (button.textContent = 'Copy'), 2000);
    });

    wrapper.append(button);
  });
</script>
