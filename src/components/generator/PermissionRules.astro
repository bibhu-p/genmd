---
import RadioGroup from '../ui/RadioGroup.astro';
import StepPanel from './StepPanel.astro';
import { PERMISSION_CATEGORIES, POLICY_OPTIONS } from '../../data/rules';
import type { FormState } from '../../types/generator';

interface Props {
  state: FormState;
}

const { state } = Astro.props;
---

<StepPanel
  id="permissions"
  description="Choose how Claude should treat each kind of command. Every category starts at Ask first."
>
  <div class="rounded-lg border border-line bg-subtle p-4 text-sm">
    <dl class="space-y-1">
      {
        POLICY_OPTIONS.map((policy) => (
          <div>
            <dt class="inline font-semibold">{policy.label}:</dt>{' '}
            <dd class="inline text-ink-muted">{policy.description}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-3 text-ink-muted">
      These rules describe how you want Claude to behave. They do not technically block commands. To
      enforce them, also configure Claude Code's permission settings.{' '}
      {/* New tab: leaving the page would lose the questionnaire answers. */}
      <a
        href="/docs/permissions/#from-claudemd-to-enforced-rules"
        target="_blank"
        rel="noopener"
        class="font-medium text-accent underline underline-offset-2"
      >How to enforce these rules<span class="sr-only"> (opens in a new tab)</span></a>
    </p>
  </div>

  {
    PERMISSION_CATEGORIES.map((category) => (
      <RadioGroup
        name={`permissions.${category.id}`}
        legend={category.label}
        hint={`${category.description} For example: ${category.examples}.`}
        options={POLICY_OPTIONS}
        checked={state.permissions[category.id]}
        showDescriptions={false}
        columns={3}
      />
    ))
  }
</StepPanel>
