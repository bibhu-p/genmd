---
import { STEPS } from '../../data/steps';

const firstStep = STEPS[0];
const lastIndex = STEPS.length - 1;
---

<!--
  One list, two layouts: a row of numbered circles joined by lines on small
  screens, and a sticky vertical list with titles from the lg breakpoint.
-->
<nav aria-label="Progress" class="lg:sticky lg:top-24">
  <p class="mb-4 text-sm font-medium text-ink-muted lg:hidden" data-progress-status>
    Step 1 of {STEPS.length} · {firstStep?.title}
  </p>
  <ol class="flex items-center lg:flex-col lg:items-stretch lg:gap-1">
    {
      STEPS.map((step, index) => (
        <li class:list={['flex items-center lg:flex-none', index === lastIndex ? 'flex-none' : 'flex-1']}>
          <button
            type="button"
            data-progress-item
            data-step-target={step.id}
            disabled={index !== 0}
            aria-current={index === 0 ? 'step' : undefined}
            class="peer group flex items-center gap-3 rounded-xl text-left transition-colors enabled:hover:bg-subtle disabled:cursor-not-allowed lg:w-full lg:px-3 lg:py-2.5 aria-[current=step]:lg:bg-accent-soft"
          >
            <span class="grid size-8 shrink-0 place-items-center rounded-full border-2 border-line-strong bg-surface text-sm font-semibold text-ink-subtle transition-colors group-aria-[current=step]:border-brand-600 group-aria-[current=step]:text-accent group-aria-[current=step]:ring-4 group-aria-[current=step]:ring-brand-500/15 group-data-complete:border-brand-600 group-data-complete:bg-brand-600 group-data-complete:text-white">
              <span class="group-data-complete:hidden">{index + 1}</span>
              <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="hidden size-4 group-data-complete:block">
                <path
                  fill-rule="evenodd"
                  d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                  clip-rule="evenodd"
                />
              </svg>
            </span>
            <span class="text-sm font-medium text-ink-muted group-disabled:text-ink-subtle group-aria-[current=step]:font-semibold group-aria-[current=step]:text-ink max-lg:sr-only">
              {step.title}
            </span>
            <span class="sr-only" data-progress-state />
          </button>
          {index < lastIndex && (
            <span
              aria-hidden="true"
              class="mx-1.5 h-0.5 flex-1 rounded-full bg-line transition-colors peer-data-complete:bg-brand-600 lg:hidden"
            />
          )}
        </li>
      ))
    }
  </ol>
</nav>
