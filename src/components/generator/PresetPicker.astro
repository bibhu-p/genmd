---
import Button from '../ui/Button.astro';
import { PRESETS } from '../../data/presets';
import { hintClass, labelClass, optionalMarkClass, selectClass } from '../ui/styles';
---

{/* No `name`: the picker only fills in other fields and is never part of the answers. */}
<div data-preset-picker class="rounded-xl border border-line bg-subtle p-4">
  <label for="preset-select" class={labelClass}>
    Start from a preset<span class={optionalMarkClass}>{' (optional)'}</span>
  </label>
  <p id="preset-hint" class={hintClass}>
    Fills in the technology stack, preferences and checks for a common setup. Your project details and command
    permissions stay as they are, and you can change anything afterwards.
  </p>
  <div class="mt-2 flex flex-col gap-3 sm:flex-row">
    <div class="relative min-w-0 flex-1">
      <select id="preset-select" data-preset-select aria-describedby="preset-hint" class={selectClass}>
        <option value="">Blank (no preset)</option>
        {PRESETS.map((preset) => <option value={preset.id}>{preset.label}</option>)}
      </select>
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="pointer-events-none absolute top-1/2 right-3 size-5 -translate-y-1/2 text-ink-subtle"
      >
        <path
          fill-rule="evenodd"
          d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
          clip-rule="evenodd"></path>
      </svg>
    </div>
    <Button variant="secondary" data-preset-apply>Apply preset</Button>
  </div>
  <p
    role="status"
    data-preset-status
    class="mt-2 text-sm font-medium empty:hidden data-[tone=error]:text-danger data-[tone=success]:text-success"
  >
  </p>
</div>
