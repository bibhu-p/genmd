---
import Button from '../ui/Button.astro';
import Field from '../ui/Field.astro';
import StepPanel from './StepPanel.astro';
import { MAX_LENGTH } from '../../lib/generator/validation';
import type { FormState } from '../../types/generator';

interface Props {
  state: FormState;
}

const { state } = Astro.props;

const tabClass =
  'rounded-md px-3 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:text-ink aria-selected:bg-surface aria-selected:text-ink aria-selected:shadow-sm';
---

<StepPanel id="review" description="Check your answers, add anything extra, then copy or download your file.">
  <details class="group rounded-xl border border-line">
    <summary
      class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-xl px-4 py-3 font-semibold hover:bg-subtle [&::-webkit-details-marker]:hidden"
    >
      Your answers
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="size-5 text-ink-subtle transition-transform group-open:rotate-180"
      >
        <path
          fill-rule="evenodd"
          d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
          clip-rule="evenodd"></path>
      </svg>
    </summary>
    <div data-review-summary class="space-y-4 border-t border-line p-4"></div>
  </details>

  <Field
    name="customInstructions"
    label="Custom instructions"
    value={state.customInstructions}
    multiline
    rows={4}
    maxlength={MAX_LENGTH.customInstructions}
    hint="Anything else Claude should know. Added to the end of the file exactly as written."
  />

  <section aria-labelledby="output-heading" data-output="claude-md">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h3 id="output-heading" class="text-lg font-semibold">Your CLAUDE.md</h3>
      <div role="tablist" aria-label="Output view" class="inline-flex rounded-lg bg-subtle p-1">
        <button type="button" role="tab" id="output-tab-edit" aria-controls="output-panel-edit" aria-selected="true" data-tab="edit" class={tabClass}>
          Edit
        </button>
        <button type="button" role="tab" id="output-tab-preview" aria-controls="output-panel-preview" aria-selected="false" tabindex="-1" data-tab="preview" class={tabClass}>
          Preview
        </button>
      </div>
    </div>

    <div data-stale-notice hidden class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-lg border border-warn bg-warn-soft px-4 py-3 text-sm text-warn-ink">
      <p>Your answers changed after you edited the file.</p>
      <button type="button" data-output-action="regenerate" class="font-semibold underline underline-offset-2">
        Regenerate (replaces your edits)
      </button>
    </div>

    <div class="mt-3 overflow-hidden rounded-xl border border-line-strong bg-surface transition-[border-color,box-shadow] focus-within:border-brand-500 focus-within:ring-4 focus-within:ring-brand-500/20">
      <div id="output-panel-edit" role="tabpanel" aria-labelledby="output-tab-edit">
        <label for="output-editor" class="sr-only">CLAUDE.md content (editable)</label>
        <textarea
          id="output-editor"
          data-output-editor
          spellcheck="false"
          rows="22"
          class="block w-full resize-y bg-surface p-4 font-mono text-sm leading-relaxed text-ink focus:outline-none"></textarea>
      </div>
      <div
        id="output-panel-preview"
        role="tabpanel"
        aria-labelledby="output-tab-preview"
        tabindex="0"
        hidden
        data-output-preview
        class="md-preview max-h-[34rem] overflow-auto p-6 focus:outline-none"
      >
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <Button data-output-action="copy">
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
          <path d="M7 3.5A1.5 1.5 0 0 1 8.5 2h3.879a1.5 1.5 0 0 1 1.06.44l3.122 3.12A1.5 1.5 0 0 1 17 6.622V12.5a1.5 1.5 0 0 1-1.5 1.5h-1v-3.379a3 3 0 0 0-.879-2.121L10.5 5.379A3 3 0 0 0 8.379 4.5H7v-1Z"></path>
          <path d="M4.5 6A1.5 1.5 0 0 0 3 7.5v9A1.5 1.5 0 0 0 4.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L9.44 6.439A1.5 1.5 0 0 0 8.378 6H4.5Z"></path>
        </svg>
        Copy
      </Button>
      <Button variant="secondary" data-output-action="download">
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
          <path d="M10.75 2.75a.75.75 0 0 0-1.5 0v8.614L6.295 8.235a.75.75 0 1 0-1.09 1.03l4.25 4.5a.75.75 0 0 0 1.09 0l4.25-4.5a.75.75 0 0 0-1.09-1.03l-2.955 3.129V2.75Z"></path>
          <path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z"></path>
        </svg>
        Download CLAUDE.md
      </Button>
      <Button variant="ghost" data-output-action="regenerate">Regenerate</Button>
      <p
        role="status"
        data-output-status
        class="text-sm font-medium data-[tone=error]:text-danger data-[tone=success]:text-success"
      >
      </p>
    </div>
  </section>

  <details class="group/settings rounded-xl border border-line">
    <summary
      class="flex cursor-pointer list-none items-start justify-between gap-4 rounded-xl px-4 py-3 hover:bg-subtle [&::-webkit-details-marker]:hidden"
    >
      <span>
        <span class="block font-semibold">Enforce these rules with <code class="font-mono text-sm">.claude/settings.json</code></span>
        <span class="mt-0.5 block text-sm text-ink-muted">Optional. Turns your command permissions into rules Claude Code applies.</span>
      </span>
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="mt-0.5 size-5 shrink-0 text-ink-subtle transition-transform group-open/settings:rotate-180"
      >
        <path
          fill-rule="evenodd"
          d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
          clip-rule="evenodd"></path>
      </svg>
    </summary>

    <section aria-labelledby="settings-heading" data-output="settings" class="border-t border-line p-4">
      <h3 id="settings-heading" class="sr-only">Your settings.json</h3>
      <div class="space-y-2 text-sm text-ink-muted [&_code]:text-ink">
        <p>
          Your CLAUDE.md tells Claude how to behave. This file makes Claude Code itself apply the same policies:
          <strong class="text-ink">Never</strong> becomes <code>deny</code>, <strong class="text-ink">Ask first</strong>
          becomes <code>ask</code> and <strong class="text-ink">Allow</strong> becomes <code>allow</code>. It also stops
          Claude reading <code>.env</code> files.
        </p>
        <p>
          Save it as <code>.claude/settings.json</code> in your project to share it with your team, or as
          <code>.claude/settings.local.json</code> to keep it to yourself.
        </p>
        <p>
          Shell rules match the command text, so treat them as a guard rail rather than a security boundary. Commands
          for tools typed under "Other" are not included, so add your own.{' '}
          {/* New tab: leaving the page would lose the questionnaire answers. */}
          <a
            href="/docs/permissions/#permission-rules"
            target="_blank"
            rel="noopener"
            class="font-medium text-accent underline underline-offset-2"
          >How permission rules work<span class="sr-only"> (opens in a new tab)</span></a>
        </p>
      </div>

      <div data-stale-notice hidden class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-lg border border-warn bg-warn-soft px-4 py-3 text-sm text-warn-ink">
        <p>Your answers changed after you edited the file.</p>
        <button type="button" data-output-action="regenerate" class="font-semibold underline underline-offset-2">
          Regenerate (replaces your edits)
        </button>
      </div>

      <p
        data-output-warning
        hidden
        aria-live="polite"
        class="mt-3 rounded-lg border border-warn bg-warn-soft px-4 py-3 text-sm text-warn-ink"
      >
      </p>

      <div class="mt-3 overflow-hidden rounded-xl border border-line-strong bg-surface transition-[border-color,box-shadow] focus-within:border-brand-500 focus-within:ring-4 focus-within:ring-brand-500/20">
        <label for="settings-editor" class="sr-only">settings.json content (editable)</label>
        <textarea
          id="settings-editor"
          data-output-editor
          spellcheck="false"
          rows="16"
          class="block w-full resize-y bg-surface p-4 font-mono text-sm leading-relaxed text-ink focus:outline-none"></textarea>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <Button data-output-action="copy">
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path d="M7 3.5A1.5 1.5 0 0 1 8.5 2h3.879a1.5 1.5 0 0 1 1.06.44l3.122 3.12A1.5 1.5 0 0 1 17 6.622V12.5a1.5 1.5 0 0 1-1.5 1.5h-1v-3.379a3 3 0 0 0-.879-2.121L10.5 5.379A3 3 0 0 0 8.379 4.5H7v-1Z"></path>
            <path d="M4.5 6A1.5 1.5 0 0 0 3 7.5v9A1.5 1.5 0 0 0 4.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L9.44 6.439A1.5 1.5 0 0 0 8.378 6H4.5Z"></path>
          </svg>
          Copy
        </Button>
        <Button variant="secondary" data-output-action="download">
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path d="M10.75 2.75a.75.75 0 0 0-1.5 0v8.614L6.295 8.235a.75.75 0 1 0-1.09 1.03l4.25 4.5a.75.75 0 0 0 1.09 0l4.25-4.5a.75.75 0 0 0-1.09-1.03l-2.955 3.129V2.75Z"></path>
            <path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z"></path>
          </svg>
          Download settings.json
        </Button>
        <Button variant="ghost" data-output-action="regenerate">Regenerate</Button>
        <p
          role="status"
          data-output-status
          class="text-sm font-medium data-[tone=error]:text-danger data-[tone=success]:text-success"
        >
        </p>
      </div>
    </section>
  </details>
</StepPanel>
