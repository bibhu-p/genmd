---
import { highlightMarkdown, type LineKind, type SegmentKind } from '../../lib/highlight';

interface Props {
  source: string;
  filename?: string;
}

const { source, filename = 'CLAUDE.md' } = Astro.props;
const lines = highlightMarkdown(source.trimEnd());

// Editor palette follows the site theme: a light editor in light mode, a dark one in dark mode.
const lineClass: Record<LineKind, string> = {
  h1: 'font-bold text-indigo-700 dark:text-indigo-300',
  h2: 'font-bold text-indigo-600 dark:text-indigo-400',
  h3: 'font-semibold text-violet-700 dark:text-violet-300',
  quote: 'italic text-slate-500 dark:text-slate-400',
  text: 'text-slate-700 dark:text-slate-300',
};

const segmentClass: Record<SegmentKind, string> = {
  plain: '',
  marker: 'text-slate-500',
  strong: 'font-semibold text-slate-900 dark:text-slate-100',
  code: 'text-sky-700 dark:text-sky-300',
};
---

<figure
  class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-brand-900/10 dark:border-slate-800 dark:bg-[#0d1117] dark:shadow-brand-900/20"
>
  <figcaption
    class="flex items-center gap-3 border-b border-slate-200 bg-slate-50 px-4 py-2.5 dark:border-slate-800 dark:bg-[#161b22]"
  >
    <span aria-hidden="true" class="flex gap-1.5">
      <span class="size-3 rounded-full bg-[#ff5f57]"></span>
      <span class="size-3 rounded-full bg-[#febc2e]"></span>
      <span class="size-3 rounded-full bg-[#28c840]"></span>
    </span>
    <span
      class="rounded-md border border-slate-200 bg-white px-2.5 py-1 font-mono text-xs text-slate-700 dark:border-transparent dark:bg-[#0d1117] dark:text-slate-300"
    >
      {filename}
    </span>
    <span class="ml-auto font-mono text-xs text-slate-500">{lines.length} lines</span>
  </figcaption>
  <div class="relative">
    <!--
      A div, not a pre: template formatting whitespace would otherwise be preserved.
      Only the line text spans keep whitespace, and they contain no formatting whitespace.
    -->
    <div
      tabindex="0"
      role="region"
      aria-label={`Example ${filename}`}
      class="max-h-[30rem] overflow-auto py-4 font-mono text-[0.8rem] leading-6 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-inset"
    >
      {
        lines.map((line, index) => (
          <div class="flex">
            <span aria-hidden="true" class="w-12 shrink-0 pr-4 text-right text-slate-400 select-none dark:text-slate-600">
              {index + 1}
            </span>
            <span class:list={['min-w-0 pr-4 break-words whitespace-pre-wrap', lineClass[line.kind]]}>{line.segments.map((segment) => <span class={segmentClass[segment.kind]}>{segment.text}</span>)}</span>
          </div>
        ))
      }
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-white dark:from-[#0d1117]"
    >
    </div>
  </div>
</figure>
