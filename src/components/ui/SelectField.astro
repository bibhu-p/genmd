---
import { OTHER_VALUE } from '../../data/frameworks';
import { errorIdFor, fieldId, hintIdFor } from '../../lib/generator/field-ids';
import type { StackOption } from '../../types/generator';
import Field from './Field.astro';
import { errorClass, hintClass, labelClass, optionalMarkClass, selectClass } from './styles';

interface Props {
  name: string;
  label: string;
  options: readonly StackOption[];
  value?: string;
  required?: boolean;
  hint?: string;
  placeholder?: string;
  /** Initial text for the "Other" box, stored under `${name}Other`. */
  otherValue?: string;
  /** Lets the controller narrow the options to the selected language. */
  filterByLanguage?: boolean;
}

const {
  name,
  label,
  options,
  value = '',
  required = false,
  hint,
  placeholder = required ? 'Select an option' : 'Not specified',
  otherValue = '',
  filterByLanguage = false,
} = Astro.props;

const id = fieldId(name);
const describedBy = [hint ? hintIdFor(name) : null, errorIdFor(name)].filter(Boolean).join(' ');
const hasOther = options.some((option) => option.value === OTHER_VALUE);
const otherWrapperId = `${id}-other`;
---

<div>
  <label for={id} class={labelClass}>
    {label}
    {!required && <span class={optionalMarkClass}>{' (optional)'}</span>}
  </label>
  {hint && <p id={hintIdFor(name)} class={hintClass}>{hint}</p>}
  <div class="relative mt-2">
    <select
      id={id}
      name={name}
      aria-required={required ? 'true' : undefined}
      aria-describedby={describedBy}
      data-other-target={hasOther ? otherWrapperId : undefined}
      data-filter-by-language={filterByLanguage ? '' : undefined}
      class={selectClass}
    >
      <option value="">{placeholder}</option>
      {
        options.map((option) => (
          <option value={option.value} selected={option.value === value} data-languages={option.languages?.join(' ')}>
            {option.label}
          </option>
        ))
      }
    </select>
    <svg
      aria-hidden="true"
      viewBox="0 0 20 20"
      fill="currentColor"
      class="pointer-events-none absolute top-1/2 right-3 size-5 -translate-y-1/2 text-ink-subtle"
    >
      <path
        fill-rule="evenodd"
        d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
        clip-rule="evenodd"></path>
    </svg>
  </div>
  <p id={errorIdFor(name)} class={errorClass} data-field-error hidden></p>
  {
    hasOther && (
      <div id={otherWrapperId} class="mt-3 border-l-2 border-accent-line pl-4" hidden={value !== OTHER_VALUE}>
        <Field name={`${name}Other`} label={`Other ${label.toLowerCase()}`} value={otherValue} required maxlength={300} />
      </div>
    )
  }
</div>
