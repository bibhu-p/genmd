---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'ghost';
type Size = 'md' | 'lg';

type Props = HTMLAttributes<'button'> & {
  variant?: Variant;
  size?: Size;
  /** Renders a link styled as a button instead of a `<button>`. */
  href?: string;
};

const { variant = 'primary', size = 'md', href, class: className, type = 'button', ...attrs } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-brand-600 text-white shadow-sm hover:bg-brand-700',
  secondary: 'border border-line-strong bg-surface text-ink shadow-xs hover:bg-subtle',
  ghost: 'text-ink-muted hover:bg-subtle hover:text-ink',
};

const sizes: Record<Size, string> = {
  md: 'px-4 py-2.5 text-sm',
  lg: 'px-5 py-3 text-base',
};

const classes = [
  'inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-60',
  variants[variant],
  sizes[size],
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...attrs}>
      <slot />
    </button>
  )
}
