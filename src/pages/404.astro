---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page Not Found" description="The page you were looking for does not exist." noindex>
  <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-sm text-accent">## 404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Page not found</h1>
    <p class="mt-3 text-ink-muted">The page you were looking for does not exist or has moved.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/">Go to the home page</Button>
      <Button href="/generator/" variant="secondary">Open the generator</Button>
    </div>
  </div>
</BaseLayout>
