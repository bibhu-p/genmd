---
import { getEntry, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { DOCS_INDEX_ID, docHref, groupBySection } from '../../lib/docs-nav';
import { getSortedDocs } from '../../lib/docs';

const entry = await getEntry('docs', DOCS_INDEX_ID);
if (!entry) throw new Error('Missing src/content/docs/index.md');

const docs = await getSortedDocs();
const { Content, headings } = await render(entry);
// Guide cards come from the collection, so they always match the pages that exist.
const guideGroups = groupBySection(docs.filter((doc) => doc.id !== DOCS_INDEX_ID));
---

<DocsLayout entry={entry} headings={headings} docs={docs}>
  <Content />

  <section slot="after" aria-labelledby="guides-heading" class="mt-12">
    <h2 id="guides-heading" class="text-2xl font-bold tracking-tight">All guides</h2>
    <div class="mt-6 space-y-8">
      {
        guideGroups.map((group) => (
          <div>
            <h3 class="text-sm font-semibold tracking-wider text-ink-subtle uppercase">{group.label}</h3>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2">
              {group.entries.map((doc) => (
                <li>
                  <a
                    href={docHref(doc.id)}
                    class="group block h-full rounded-xl border border-line bg-surface p-4 transition-colors hover:border-line-strong hover:bg-subtle"
                  >
                    <span class="font-semibold group-hover:text-accent">{doc.data.title}</span>
                    <span class="mt-1 block text-sm text-ink-muted">{doc.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</DocsLayout>
