---
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { DOCS_INDEX_ID } from '../../lib/docs-nav';
import { getSortedDocs, type DocEntry } from '../../lib/docs';

// Every docs page except the landing page, which lives in docs/index.astro.
export async function getStaticPaths() {
  const docs = await getSortedDocs();
  return docs
    .filter((entry) => entry.id !== DOCS_INDEX_ID)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: DocEntry;
}

const { entry } = Astro.props;
const docs = await getSortedDocs();
const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} headings={headings} docs={docs}>
  <Content />
</DocsLayout>
